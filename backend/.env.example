# Optional. Without any keys the app runs on a deterministic demo mock.

# Primary vision path: Amazon Bedrock, Nova Lite. Needs an AWS account with
# Bedrock model access enabled for amazon.nova-lite-v1:0 in AWS_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Fallback vision path, used only if Bedrock isn't configured or fails.
GEMINI_API_KEY=

# Required for /auth login/register. Use a long random string in production.
JWT_SECRET=

PORT=5000

# Postgres. PG_* is used by `npm run setup-db` (database/createDb.js) to
# connect as the superuser and create the app database if it's missing —
# fill in only the password, the rest matches a stock local install.
# DATABASE_URL is what the app itself connects with; keep its password in
# sync with PG_PASSWORD.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/reloop_ai

# Grade-result and impact-totals cache. Falls back to no caching if unset
# or unreachable.
REDIS_URL=redis://localhost:6379
