# Optional. Without any keys the app runs on a deterministic demo mock.

# Primary vision path: Amazon Bedrock, Nova Lite. Needs an AWS account with
# Bedrock model access enabled for amazon.nova-lite-v1:0 in AWS_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Fallback vision path, used only if Bedrock isn't configured or fails.
GEMINI_API_KEY=

# Required for /auth login/register. Use a long random string in production.
JWT_SECRET=

PORT=5000
